# Use your Mac's LAN IP instead of localhost when running on a physical device.
EXPO_PUBLIC_CMS_URL=http://localhost:8080
EXPO_PUBLIC_IAM_URL=http://localhost:4003
# Optional local iPhone signing team. Find it under Xcode's Personal Team.
EXPO_IOS_APPLE_TEAM_ID=

# Public, unique build/release identity for RUX. Never put a service token here.
# EXPO_PUBLIC_APP_RELEASE=build-id
